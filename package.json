{
  "name": "branchwise",
  "displayName": "Branchwise",
  "version": "0.9.10",
  "description": "%description%",
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "keywords": [
    "bisect",
    "branch",
    "cherry-pick",
    "commit",
    "commit graph",
    "diff",
    "git",
    "git graph",
    "git history",
    "git log",
    "graph",
    "history",
    "log",
    "merge",
    "rebase",
    "reflog",
    "stash",
    "submodule",
    "visualization",
    "worktree"
  ],
  "homepage": "https://github.com/jcfurey/Branchwise",
  "bugs": {
    "url": "https://github.com/jcfurey/Branchwise/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jcfurey/Branchwise.git"
  },
  "publisher": "jcfurey",
  "main": "./out/extension.js",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\"",
    "clean:all": "node -e \"const fs = require('node:fs'); for (const entry of ['out', 'tests-ext/out', '.vscode-test', 'test-results', ...fs.readdirSync('.').filter((name) => name.endsWith('.vsix'))]) fs.rmSync(entry, { recursive: true, force: true })\"",
    "compile": "pnpm run clean && node esbuild.js",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc -p . --watch",
    "typecheck": "tsc -p . && tsc -p src/webview && tsc -p tests && tsc -p tests/webview && tsc -p tests-ext --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "package": "pnpm run typecheck && pnpm run lint && pnpm run check:notices && node esbuild.js --production",
    "vscode:prepublish": "pnpm run clean && pnpm run package",
    "package:vsix": "node scripts/check-release.cjs && vsce package --no-dependencies",
    "test": "vitest run",
    "test:coverage": "vitest run --project webview --coverage",
    "compile-tests": "tsc -p tests-ext/tsconfig.json && tsc-alias -p tests-ext/tsconfig.json",
    "test:ext": "pnpm run clean && node esbuild.js --production && pnpm run compile-tests && vscode-test",
    "test:ui-harness": "node --test tests-ext/ui/diagnostics.unit.cjs && node esbuild.js --production && pnpm run compile-tests && node scripts/test-ui-harness.cjs",
    "test:lint-rules": "node --test oxlint/webview-text.test.cjs",
    "test:release": "node --test scripts/check-l10n.test.cjs scripts/check-release.test.cjs scripts/markdown-links.test.cjs scripts/third-party-notices.test.cjs",
    "test:package": "node scripts/test-package.cjs",
    "benchmark": "node scripts/benchmark.mjs",
    "benchmark:ui": "node esbuild.js --production && node scripts/benchmark-ui.cjs",
    "screenshots": "node esbuild.js --production && node scripts/screenshots.cjs",
    "l10n:export": "vscode-l10n-dev export --outDir ./l10n ./src && oxfmt ./l10n/bundle.l10n.json",
    "l10n:check": "pnpm run l10n:export && git diff --exit-code -- l10n/bundle.l10n.json && node scripts/check-l10n.js",
    "check:release": "node scripts/check-release.cjs",
    "check:links": "node scripts/markdown-links.cjs",
    "check:notices": "node scripts/third-party-notices.cjs --check",
    "notices": "node scripts/third-party-notices.cjs"
  },
  "dependencies": {
    "@preact/signals": "^2.11.2",
    "@vscode/l10n": "^0.0.18",
    "preact": "^10.29.8",
    "simple-git": "^4.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "~26.6.3",
    "@types/vscode": "~1.125.0",
    "@vitest/coverage-v8": "5.0.2",
    "@vscode/l10n-dev": "^0.0.35",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^30.1.1",
    "ovsx": "^1.2.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsc-alias": "^1.9.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "branchwise.view",
        "category": "Branchwise",
        "title": "%command.view%",
        "icon": {
          "light": "resources/webview-icon-light.svg",
          "dark": "resources/webview-icon-dark.svg"
        }
      },
      {
        "command": "branchwise.fileHistory",
        "category": "Branchwise",
        "title": "%command.fileHistory%"
      },
      {
        "command": "branchwise.showBranches",
        "category": "Branchwise",
        "title": "%command.showBranches%"
      },
      {
        "command": "branchwise.goTo",
        "category": "Branchwise",
        "title": "%command.goTo%"
      },
      {
        "command": "branchwise.openDocumentation",
        "category": "Branchwise",
        "title": "%command.openDocumentation%"
      },
      {
        "command": "branchwise.openWalkthrough",
        "category": "Branchwise",
        "title": "%command.openWalkthrough%"
      }
    ],
    "keybindings": [
      {
        "command": "branchwise.goTo",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g",
        "when": "activeWebviewPanelId == 'branchwise' && !sideBarFocus && !panelFocus && !auxiliaryBarFocus"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "branchwise.view",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "explorer/context": [
        {
          "command": "branchwise.fileHistory",
          "group": "git",
          "when": "(resourceScheme == file || resourceScheme == vscode-remote) && !explorerResourceIsFolder"
        }
      ],
      "editor/title/context": [
        {
          "command": "branchwise.fileHistory",
          "group": "git",
          "when": "resourceScheme == file || resourceScheme == vscode-remote"
        }
      ]
    },
    "configuration": {
      "title": "Branchwise",
      "type": "object",
      "properties": {
        "branchwise.autoCenterCommitDetailsView": {
          "description": "%config.autoCenterCommitDetailsView%",
          "type": "boolean",
          "default": true
        },
        "branchwise.branchHoverPreview": {
          "description": "%config.branchHoverPreview%",
          "type": "boolean",
          "default": true
        },
        "branchwise.commitHoverCards": {
          "description": "%config.commitHoverCards%",
          "type": "boolean",
          "default": true
        },
        "branchwise.conflictForecast": {
          "description": "%config.conflictForecast%",
          "type": "string",
          "default": "localAndRemote",
          "enum": [
            "localAndRemote",
            "local",
            "off"
          ],
          "enumDescriptions": [
            "%config.conflictForecast.localAndRemote%",
            "%config.conflictForecast.local%",
            "%config.conflictForecast.off%"
          ]
        },
        "branchwise.dateFormat": {
          "description": "%config.dateFormat%",
          "type": "string",
          "default": "Date & Time",
          "enum": [
            "Date & Time",
            "Date Only",
            "Relative"
          ],
          "enumDescriptions": [
            "%config.dateFormat.dateTime%",
            "%config.dateFormat.dateOnly%",
            "%config.dateFormat.relative%"
          ]
        },
        "branchwise.dateSeparators": {
          "description": "%config.dateSeparators%",
          "type": "boolean",
          "default": true
        },
        "branchwise.dateType": {
          "description": "%config.dateType%",
          "type": "string",
          "default": "Author Date",
          "enum": [
            "Author Date",
            "Commit Date"
          ],
          "enumDescriptions": [
            "%config.dateType.authorDate%",
            "%config.dateType.commitDate%"
          ]
        },
        "branchwise.dragAndDrop": {
          "description": "%config.dragAndDrop%",
          "type": "boolean",
          "default": true
        },
        "branchwise.fetchAvatars": {
          "description": "%config.fetchAvatars%",
          "deprecationMessage": "%config.fetchAvatars.deprecation%",
          "type": "boolean",
          "default": false
        },
        "branchwise.graphColours": {
          "description": "%config.graphColours%",
          "type": "array",
          "default": [
            "#0085d9",
            "#d9008f",
            "#00d90a",
            "#d98500",
            "#a300d9",
            "#ff0000",
            "#00d9cc",
            "#e138e8",
            "#85d900",
            "#dc5b23",
            "#6f24d6",
            "#ffcc00"
          ],
          "items": {
            "description": "%config.graphColours.item%",
            "type": "string",
            "pattern": "^\\s*(#[0-9a-fA-F]{6}|#[0-9a-fA-F]{8}|rgba?\\s*\\(\\d{1,3},\\s*\\d{1,3},\\s*\\d{1,3}\\))\\s*$"
          }
        },
        "branchwise.graphStyle": {
          "description": "%config.graphStyle%",
          "type": "string",
          "default": "rounded",
          "enum": [
            "rounded",
            "angular"
          ],
          "enumDescriptions": [
            "%config.graphStyle.rounded%",
            "%config.graphStyle.angular%"
          ]
        },
        "branchwise.initialLoadCommits": {
          "description": "%config.initialLoadCommits%",
          "type": "integer",
          "default": 300,
          "minimum": 1
        },
        "branchwise.issueLinks": {
          "description": "%config.issueLinks%",
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "pattern",
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "pattern": {
                "description": "%config.issueLinks.pattern%",
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "url": {
                "description": "%config.issueLinks.url%",
                "type": "string",
                "pattern": "^[hH][tT][tT][pP][sS]?://[^/\\s]"
              }
            }
          }
        },
        "branchwise.loadMoreCommits": {
          "description": "%config.loadMoreCommits%",
          "type": "integer",
          "default": 100,
          "minimum": 1
        },
        "branchwise.maxDepthOfRepoSearch": {
          "description": "%config.maxDepthOfRepoSearch%",
          "type": "integer",
          "default": 0,
          "minimum": 0
        },
        "branchwise.nestedRepoSearchDepth": {
          "description": "%config.nestedRepoSearchDepth%",
          "type": "integer",
          "default": 3,
          "minimum": 0
        },
        "branchwise.overviewMarkers": {
          "description": "%config.overviewMarkers%",
          "type": "boolean",
          "default": true
        },
        "branchwise.showChangesColumn": {
          "description": "%config.showChangesColumn%",
          "type": "boolean",
          "default": false
        },
        "branchwise.showCurrentBranchByDefault": {
          "description": "%config.showCurrentBranchByDefault%",
          "type": "boolean",
          "default": false
        },
        "branchwise.showNearestBranch": {
          "description": "%config.showNearestBranch%",
          "type": "boolean",
          "default": true
        },
        "branchwise.showSignatures": {
          "description": "%config.showSignatures%",
          "type": "boolean",
          "default": true
        },
        "branchwise.showUncommittedChanges": {
          "description": "%config.showUncommittedChanges%",
          "type": "boolean",
          "default": true
        },
        "branchwise.singleKeyShortcuts": {
          "description": "%config.singleKeyShortcuts%",
          "type": "boolean",
          "default": true
        },
        "branchwise.tabIconColourTheme": {
          "description": "%config.tabIconColourTheme%",
          "type": "string",
          "default": "colour",
          "enum": [
            "colour",
            "grey"
          ],
          "enumDescriptions": [
            "%config.tabIconColourTheme.colour%",
            "%config.tabIconColourTheme.grey%"
          ]
        }
      }
    },
    "colors": [
      {
        "id": "branchwise.graphLane1",
        "description": "%colors.graphLane1%",
        "defaults": {
          "dark": "#0085d9",
          "light": "#0085d9",
          "highContrast": "#0085d9",
          "highContrastLight": "#0085d9"
        }
      },
      {
        "id": "branchwise.graphLane2",
        "description": "%colors.graphLane2%",
        "defaults": {
          "dark": "#d9008f",
          "light": "#d9008f",
          "highContrast": "#d9008f",
          "highContrastLight": "#d9008f"
        }
      },
      {
        "id": "branchwise.graphLane3",
        "description": "%colors.graphLane3%",
        "defaults": {
          "dark": "#00d90a",
          "light": "#00d90a",
          "highContrast": "#00d90a",
          "highContrastLight": "#00d90a"
        }
      },
      {
        "id": "branchwise.graphLane4",
        "description": "%colors.graphLane4%",
        "defaults": {
          "dark": "#d98500",
          "light": "#d98500",
          "highContrast": "#d98500",
          "highContrastLight": "#d98500"
        }
      },
      {
        "id": "branchwise.graphLane5",
        "description": "%colors.graphLane5%",
        "defaults": {
          "dark": "#a300d9",
          "light": "#a300d9",
          "highContrast": "#a300d9",
          "highContrastLight": "#a300d9"
        }
      },
      {
        "id": "branchwise.graphLane6",
        "description": "%colors.graphLane6%",
        "defaults": {
          "dark": "#ff0000",
          "light": "#ff0000",
          "highContrast": "#ff0000",
          "highContrastLight": "#ff0000"
        }
      },
      {
        "id": "branchwise.graphLane7",
        "description": "%colors.graphLane7%",
        "defaults": {
          "dark": "#00d9cc",
          "light": "#00d9cc",
          "highContrast": "#00d9cc",
          "highContrastLight": "#00d9cc"
        }
      },
      {
        "id": "branchwise.graphLane8",
        "description": "%colors.graphLane8%",
        "defaults": {
          "dark": "#e138e8",
          "light": "#e138e8",
          "highContrast": "#e138e8",
          "highContrastLight": "#e138e8"
        }
      },
      {
        "id": "branchwise.graphLane9",
        "description": "%colors.graphLane9%",
        "defaults": {
          "dark": "#85d900",
          "light": "#85d900",
          "highContrast": "#85d900",
          "highContrastLight": "#85d900"
        }
      },
      {
        "id": "branchwise.graphLane10",
        "description": "%colors.graphLane10%",
        "defaults": {
          "dark": "#dc5b23",
          "light": "#dc5b23",
          "highContrast": "#dc5b23",
          "highContrastLight": "#dc5b23"
        }
      },
      {
        "id": "branchwise.graphLane11",
        "description": "%colors.graphLane11%",
        "defaults": {
          "dark": "#6f24d6",
          "light": "#6f24d6",
          "highContrast": "#6f24d6",
          "highContrastLight": "#6f24d6"
        }
      },
      {
        "id": "branchwise.graphLane12",
        "description": "%colors.graphLane12%",
        "defaults": {
          "dark": "#ffcc00",
          "light": "#ffcc00",
          "highContrast": "#ffcc00",
          "highContrastLight": "#ffcc00"
        }
      },
      {
        "id": "branchwise.unpushed",
        "description": "%colors.unpushed%",
        "defaults": {
          "dark": "gitDecoration.modifiedResourceForeground",
          "light": "gitDecoration.modifiedResourceForeground",
          "highContrast": "gitDecoration.modifiedResourceForeground",
          "highContrastLight": "gitDecoration.modifiedResourceForeground"
        }
      },
      {
        "id": "branchwise.conflict",
        "description": "%colors.conflict%",
        "defaults": {
          "dark": "gitDecoration.conflictingResourceForeground",
          "light": "gitDecoration.conflictingResourceForeground",
          "highContrast": "gitDecoration.conflictingResourceForeground",
          "highContrastLight": "gitDecoration.conflictingResourceForeground"
        }
      }
    ],
    "walkthroughs": [
      {
        "id": "gettingStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "openGraph",
            "title": "%walkthrough.openGraph.title%",
            "description": "%walkthrough.openGraph.description%",
            "media": {
              "markdown": "walkthroughs/open-graph.md"
            },
            "completionEvents": [
              "onCommand:branchwise.view"
            ]
          },
          {
            "id": "readGraph",
            "title": "%walkthrough.readGraph.title%",
            "description": "%walkthrough.readGraph.description%",
            "media": {
              "markdown": "walkthroughs/read-graph.md"
            }
          },
          {
            "id": "actOnCommit",
            "title": "%walkthrough.actOnCommit.title%",
            "description": "%walkthrough.actOnCommit.description%",
            "media": {
              "markdown": "walkthroughs/act-on-commit.md"
            }
          },
          {
            "id": "branchesPane",
            "title": "%walkthrough.branchesPane.title%",
            "description": "%walkthrough.branchesPane.description%",
            "media": {
              "markdown": "walkthroughs/branches-pane.md"
            },
            "completionEvents": [
              "onCommand:branchwise.showBranches"
            ]
          },
          {
            "id": "focusAndRemotes",
            "title": "%walkthrough.focusAndRemotes.title%",
            "description": "%walkthrough.focusAndRemotes.description%",
            "media": {
              "markdown": "walkthroughs/focus-and-remotes.md"
            }
          },
          {
            "id": "recover",
            "title": "%walkthrough.recover.title%",
            "description": "%walkthrough.recover.description%",
            "media": {
              "markdown": "walkthroughs/recover.md"
            },
            "completionEvents": [
              "onCommand:branchwise.openDocumentation"
            ]
          }
        ]
      }
    ]
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "packageManager": "pnpm@11.15.1",
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capabilities.virtualWorkspaces%"
    },
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrustedWorkspaces%"
    }
  }
}
